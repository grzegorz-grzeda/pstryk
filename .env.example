# Public hostname Caddy gets a certificate for (DNS A record must point to the VPS)
PSTRYK_DOMAIN=pstryk.example.com
PUBLIC_URL=https://pstryk.example.com

# MongoDB Atlas connection string (Atlas → Connect → Drivers).
# Add the VPS public IP under Atlas → Network Access.
MONGODB_URI=mongodb+srv://pstryk:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=pstryk

# MQTT broker. Use mqtts:// for TLS, e.g. mqtts://broker.example.com:8883
# For the bundled broker: mqtt://mosquitto:1883
MQTT_URL=mqtts://broker.example.com:8883
MQTT_USERNAME=pstryk
MQTT_PASSWORD=
# MQTT_CLIENT_ID=pstryk

# Admin UI login (HTTP Basic auth). Password must be at least 12 characters.
ADMIN_USER=admin
ADMIN_PASSWORD=

# Optional tuning
# ALLOW_QUERY_TOKEN=false   # accept ?token=... for clients that can't send headers
# RATE_LIMIT_MAX=60         # webhook requests per minute per IP
# BODY_LIMIT=65536          # max request body in bytes
# CALL_LOG_DAYS=30          # how long call history is kept
# LOG_LEVEL=info
